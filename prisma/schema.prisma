generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  STUDENT
  OUTSIDER
}

enum VerificationType {
  EMAIL
  PHONE
}

enum ListingStatus {
  ACTIVE
  SOLD
  EXPIRED
}

enum SubscriptionPlan {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum DigitalProductType {
  DATA
  AIRTIME
}

enum DigitalOrderStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  PROCESSING
  SUCCESS
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                String             @id @default(cuid())
  name              String
  country           String
  university        String
  accountType       AccountType
  phone             String             @unique
  email             String             @unique
  passwordHash      String
  emailVerified     Boolean            @default(false)
  phoneVerified     Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  listings          Listing[]
  sentMessages      Message[]          @relation("SentMessages")
  receivedMessages  Message[]          @relation("ReceivedMessages")
  verificationCodes VerificationCode[]
  setting           UserSetting?
  cartItems         CartItem[]
  notifications     Notification[]
  buyerOrders       Order[]            @relation("BuyerOrders")
  sellerOrders      Order[]            @relation("SellerOrders")

  // Campus Mall Pro
  proSubscriptions  ProSubscription[]
  proPayments       ProPayment[]

  // Campus Mall Digital
  digitalOrders     DigitalOrder[]

  @@index([country])
  @@index([university])
  @@index([email])
  @@index([phone])
}

model VerificationCode {
  id        String           @id @default(cuid())
  userId    String
  type      VerificationType
  code      String
  expiresAt DateTime
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model Listing {
  id            String        @id @default(cuid())
  sellerId      String
  title         String
  description   String
  price         Decimal       @db.Decimal(12, 2)
  currency      String        @default("KES")
  category      String
  imageUrl      String?
  location      String
  status        ListingStatus @default(ACTIVE)
  soldAt        DateTime?
  promoted      Boolean       @default(false)
  promotedUntil DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  seller    User       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  messages  Message[]
  cartItems CartItem[]
  orders    Order[]

  @@index([sellerId])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@index([promoted])
  @@index([promotedUntil])
}

model Message {
  id         String    @id @default(cuid())
  listingId  String
  senderId   String
  receiverId String
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sender   User    @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User    @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@index([senderId, receiverId])
  @@index([receiverId, createdAt])
}

model UserSetting {
  id             String   @id @default(cuid())
  userId         String   @unique
  emailAlerts    Boolean  @default(true)
  messageAlerts  Boolean  @default(true)
  marketing      Boolean  @default(false)
  publicProfile  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Order {
  id         String   @id @default(cuid())
  listingId  String
  buyerId    String
  sellerId   String
  quantity   Int      @default(1)
  amount     Decimal  @db.Decimal(12, 2)
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer   User    @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  User    @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
}

model ProSubscription {
  id                String             @id @default(cuid())
  userId            String
  plan              SubscriptionPlan
  status            SubscriptionStatus @default(PENDING)
  amount            Int
  currency          String             @default("KES")
  startedAt         DateTime?
  expiresAt         DateTime?
  cancelledAt       DateTime?
  provider          String?
  providerReference String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments ProPayment[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
}

model ProPayment {
  id                String        @id @default(cuid())
  subscriptionId    String
  userId            String
  amount            Int
  currency          String        @default("KES")
  status            PaymentStatus @default(PENDING)
  provider          String?
  providerReference String?
  checkoutReference String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  subscription ProSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subscriptionId])
  @@index([providerReference])
  @@index([checkoutReference])
}

model DigitalProduct {
  id          String             @id @default(cuid())
  name        String
  description String?
  type        DigitalProductType
  category    String
  provider    String
  price       Decimal            @db.Decimal(12, 2)
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  orders      DigitalOrder[]

  @@index([type])
  @@index([category])
  @@index([provider])
  @@index([active])
  @@index([createdAt])
}

model DigitalOrder {
  id                String             @id @default(cuid())
  userId            String
  productId         String
  phone             String
  amount            Decimal            @db.Decimal(12, 2)
  status            DigitalOrderStatus @default(PENDING_PAYMENT)
  providerReference String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
  @@index([phone])
  @@index([status])
  @@index([providerReference])
  @@index([createdAt])
}


model PaymentIntent {
  id String @id @default(cuid())
  userId String
  purpose String
  reference String @unique
  amount Decimal @db.Decimal(12,2)
  currency String @default("KES")
  phone String
  status String @default("PENDING")
  provider String @default("MPESA")
  merchantRequestId String?
  checkoutRequestId String? @unique
  resultCode Int?
  resultDesc String?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,status])
  @@index([purpose,createdAt])
}

model RevenueTransaction {
  id String @id @default(cuid())
  userId String?
  type String
  reference String @unique
  gross Decimal @db.Decimal(12,2)
  fee Decimal @db.Decimal(12,2) @default(0)
  net Decimal @db.Decimal(12,2)
  currency String @default("KES")
  status String @default("PENDING")
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,createdAt])
  @@index([type,status,createdAt])
}

model PromotionPurchase {
  id String @id @default(cuid())
  userId String
  listingId String
  paymentIntentId String? @unique
  days Int
  amount Decimal @db.Decimal(12,2)
  status String @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,status])
  @@index([listingId,status])
}

model BusinessSubscription {
  id String @id @default(cuid())
  userId String
  plan String
  amount Decimal @db.Decimal(12,2)
  currency String @default("KES")
  status String @default("PENDING")
  paymentIntentId String? @unique
  startedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,status])
}

model AdCampaign {
  id String @id @default(cuid())
  userId String
  title String
  budget Decimal @db.Decimal(12,2)
  status String @default("PENDING_PAYMENT")
  paymentIntentId String? @unique
  startsAt DateTime?
  endsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId,status])
}

model AffiliatePartner {
  id String @id @default(cuid())
  name String
  trackingId String?
  commissionRate Decimal? @db.Decimal(8,4)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
